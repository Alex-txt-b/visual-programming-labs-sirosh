        "type": "http in",
        "z": "tab_flow_08_sirosh",
        "name": "GET /api/items/:id",
        "url": "/api/items/:id",
        "method": "get",
        "upload": false,
        "swaggerDoc": "",
        "x": 210,
        "y": 320,
        "wires": [
            [
                "fn_check_items"
            ]
        ]
    },
    {
        "id": "fn_check_items",
        "type": "function",
        "z": "tab_flow_08_sirosh",
        "name": "Поиск элемента и валидация",
        "func": "const id = msg.req.params.id;\n\n// База данных элементов\nconst items = {\n    \"1\": { \"id\": 1, \"name\": \"Ноутбук\", \"category\": \"electronics\" },\n    \"2\": { \"id\": 2, \"name\": \"Мышь\", \"category\": \"accessories\" },\n    \"3\": { \"id\": 3, \"name\": \"Клавиатура\", \"category\": \"accessories\" }\n};\n\n// 1. Проверка на нечисловой параметр (Ошибка 400 Bad Request)\nif (isNaN(id)) {\n    msg.statusCode = 400;\n    msg.payload = {\n        \"error\": \"Bad Request\",\n        \"message\": \"Параметр id должен быть числом\"\n    };\n    return msg;\n}\n\n// 2. Проверка наличия элемента (Успех 200 или Ошибка 404 Not Found)\nif (items[id]) {\n    msg.statusCode = 200;\n    msg.payload = items[id];\n} else {\n    msg.statusCode = 404;\n    msg.payload = {\n        \"error\": \"Not Found\",\n        \"message\": `Элемент с id=${id} не найден`\n    };\n}\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 470,
        "y": 320,
        "wires": [
            [
                "http_res_items"
            ]
        ]
    },
