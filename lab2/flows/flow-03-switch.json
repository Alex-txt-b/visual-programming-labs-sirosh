        "id": "func_node_03",
        "type": "function",
        "z": "tab_flow_03",
        "name": "Расчет среднего балла",
        "func": "const student = {\n    lastName: \"Сирош\",\n    firstName: \"Александр\",\n    group: \"AI241\"\n};\n\n// Получаем массив из inject или берем по умолчанию\nconst scores = Array.isArray(msg.payload) ? msg.payload : [85, 92, 78, 95, 64, 88];\nlet total = 0;\n\nfor (let i = 0; i < scores.length; i++) {\n    total += scores[i];\n}\n\nconst average = Number((total / scores.length).toFixed(2));\n\nmsg.topic = \"lab2/sirosh/switch\";\nmsg.payload = {\n    student: student,\n    scores: scores,\n    averageScore: average,\n    status: average >= 75 ? \"Passed\" : \"Failed\"\n};\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
