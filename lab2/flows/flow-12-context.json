    {
        "id": "fn_counter_context",
        "type": "function",
        "z": "tab_flow_12_sirosh",
        "name": "Логика счётчика (flow context)",
        "func": "// 1. Читаем текущее значение из контекста потока (если его нет — начинаем с 0)\nlet count = flow.get(\"counter\") || 0;\n\n// 2. Обрабатываем действие\nif (msg.payload === \"reset\") {\n    count = 0;\n} else {\n    count += 1;\n}\n\n// 3. Сохраняем обновленное значение обратно в flow context\nflow.set(\"counter\", count);\n\n// 4. Выводим статус прямо под узлом на холсте\nnode.status({ fill: \"blue\", shape: \"dot\", text: \"Счётчик: \" + count });\n\n// 5. Формируем сообщение для отладки\nmsg.payload = {\n    student: \"Сирош AI241\",\n    action: msg.payload === \"reset\" ? \"Сброс в 0\" : \"Добавить (+1)\",\n    currentCount: count\n};\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 490,
        "y": 540,
        "wires": [
            [
                "debug_context_out"
            ]
        ]
    },
