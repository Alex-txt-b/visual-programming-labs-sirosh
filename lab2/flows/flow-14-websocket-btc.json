    {
        "id": "fn_parse_btc",
        "type": "function",
        "z": "tab_flow_14_sirosh",
        "name": "Парсинг курса BTC",
        "func": "let data = msg.payload;\n\n// Если пришла строка, парсим JSON\nif (typeof data === \"string\") {\n    data = JSON.parse(data);\n}\n\n// Поле 'c' в Binance Ticker означает текущую цену закрытия (Close Price)\nlet price = parseFloat(data.c);\n\n// Показываем цену в статусе под узлом\nnode.status({ fill: \"green\", shape: \"dot\", text: `$${price.toFixed(2)}` });\n\nmsg.payload = price;\nmsg.topic = \"BTC / USDT\";\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 520,
        "y": 180,
        "wires": [
            [
                "ui_chart_btc",
                "ui_text_btc"
            ]
        ]
    },
