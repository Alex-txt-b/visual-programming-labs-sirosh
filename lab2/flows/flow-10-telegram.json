    {
        "id": "tg_fn_logic",
        "type": "function",
        "z": "tab_flow_10_sirosh",
        "name": "Обработка команд и эхо",
        "func": "const chatId = msg.payload.chatId;\nconst text = msg.payload.content || \"\";\n\n// 1. Обязательная команда /start\nif (text === \"/start\") {\n    msg.payload = {\n        chatId: chatId,\n        type: \"message\",\n        content: \"Привет! Я бот студента Сирош (группа AI241).\\nДоступные команды:\\n/start — перезапуск бота\\n/info — информация о студенте\\nИли просто напишите любой текст для эхо-ответа!\"\n    };\n}\n// 2. Команда на выбор студента (/info)\nelse if (text === \"/info\") {\n    msg.payload = {\n        chatId: chatId,\n        type: \"message\",\n        content: \"Лабораторная работа 2.10\\nСтудент: Сирош\\nГруппа: AI241\\nСервер: Node-RED на localhost:1880\\nСтатус: Бот работает отлично!\"\n    };\n}\n// 3. Эхо-ответ на любое произвольное сообщение\nelse {\n    msg.payload = {\n        chatId: chatId,\n        type: \"message\",\n        content: \"Эхо: \" + text\n    };\n}\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
